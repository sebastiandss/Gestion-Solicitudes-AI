---
import BaseLayout from "../layouts/BaseLayout.astro";
import TopBar from "../components/TopBar.astro";
import NavigationTabs from "../components/NavigationTabs.astro";
import MisTramites from "../components/views/MisTramites.astro";
import NuevaSolicitud from "../components/views/NuevaSolicitud.astro";
import ProgramasDisponibles from "../components/views/ProgramasDisponibles.astro";
import Beneficiarios from "../components/views/Beneficiarios.astro";
import Notificaciones from "../components/views/Notificaciones.astro";
import AdminPanel from "../components/views/AdminPanel.astro";

// ── SSR: session check via middleware ──
// La middleware ya protege la ruta y pone locals.user.
// Este doble check es por si la middleware no está configurada.
const user = Astro.locals.user;
if (!user) {
  return Astro.redirect('/login');
}

const idInfo = user.cedula
  ? `CC ${user.cedula} · Afiliado activo`
  : 'Afiliado activo';
---

<BaseLayout title="BeneficIA Social">
  <TopBar
    initials={user.initials}
    name={user.name}
    idInfo={idInfo}
    userId={user.id}
    userEmail={user.email}
  />

  <NavigationTabs esAdmin={Astro.locals.esAdmin ?? false} />

  <MisTramites esAdmin={Astro.locals.esAdmin ?? false} />
  <NuevaSolicitud />
  <ProgramasDisponibles />
  <Beneficiarios />
  <Notificaciones />
  <AdminPanel esAdmin={Astro.locals.esAdmin ?? false} />
</BaseLayout>
