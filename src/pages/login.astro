---
import BaseLayout from '../layouts/BaseLayout.astro';

// Si ya está autenticado, redirigir al dashboard (SSR check)
const sessionCookie = Astro.cookies.get('appwrite_session');
const userIdCookie = Astro.cookies.get('appwrite_user_id');
const { getCurrentUser } = await import('../lib/auth');
let redirect = false;

if (sessionCookie?.value && userIdCookie?.value) {
  const decodedSecret = decodeURIComponent(sessionCookie.value);
  const user = await getCurrentUser(decodedSecret, userIdCookie.value);
  if (user) redirect = true;
}

if (redirect) {
  return Astro.redirect('/');
}
---

<BaseLayout title="BeneficIA Social — Acceder">
  <div class="auth-container">
    <div class="auth-card">
      
      <div class="auth-header">
        <div class="auth-logo">BeneficIA Social</div>
        <p class="auth-subtitle">Gestiona tus auxilios y beneficios fácil y rápido</p>
      </div>

      <!-- Error Alert -->
      <div id="auth-alert" class="auth-alert" style="display:none;"></div>

      <!-- Formulario de Login -->
      <form id="form-login" class="auth-form" onsubmit="handleLogin(event)">
        <div class="form-row-1">
          <label class="flabel">Correo electrónico</label>
          <input
            class="finput"
            type="email"
            id="login-email"
            placeholder="ej. maria@ejemplo.com"
            autocomplete="email"
            required
          />
        </div>
        <div class="form-row-1">
          <label class="flabel">Contraseña</label>
          <div class="password-wrapper">
            <input
              class="finput"
              type="password"
              id="login-password"
              placeholder="••••••••"
              autocomplete="current-password"
              required
            />
            <button type="button" class="pw-toggle" onclick="togglePassword('login-password')" aria-label="Mostrar contraseña" tabindex="-1">
              <svg class="eye-open" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"/><circle cx="12" cy="12" r="3"/></svg>
              <svg class="eye-closed" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="display:none;"><path d="M17.94 17.94A10.07 10.07 0 0 1 12 20c-7 0-11-8-11-8a18.45 18.45 0 0 1 5.06-5.94M9.9 4.24A9.12 9.12 0 0 1 12 4c7 0 11 8 11 8a18.5 18.5 0 0 1-2.16 3.19m-6.72-1.07a3 3 0 1 1-4.24-4.24"/><line x1="1" y1="1" x2="23" y2="23"/></svg>
            </button>
          </div>
        </div>

        <button type="submit" class="submit-btn" id="btn-login">
          Ingresar de forma segura →
        </button>
      </form>

    </div>
  </div>
</BaseLayout>

<style>
  .auth-container {
    display: flex;
    align-items: center;
    justify-content: center;
    min-height: 80vh;
  }

  .auth-card {
    background: var(--surface);
    border: 0.5px solid var(--border);
    border-radius: var(--radius-lg);
    padding: 2.5rem 2rem;
    width: 100%;
    max-width: 440px;
    box-shadow: 0 10px 25px rgba(0,0,0,0.05);
  }

  .auth-header {
    text-align: center;
    margin-bottom: 1.5rem;
  }

  .auth-logo {
    font-size: 22px;
    font-weight: 600;
    color: var(--blue-800);
    margin-bottom: 6px;
    letter-spacing: -0.5px;
  }

  .auth-subtitle {
    font-size: 13px;
    color: var(--text-secondary);
  }

  .auth-alert {
    background: var(--red-50);
    border: 0.5px solid var(--red-400);
    border-radius: var(--radius-md);
    padding: 10px 14px;
    font-size: 13px;
    color: var(--red-800);
    margin-bottom: 1rem;
    line-height: 1.4;
  }

  .password-wrapper {
    position: relative;
    display: flex;
    align-items: center;
  }
  
  .password-wrapper .finput {
    padding-right: 40px;
  }
  
  .pw-toggle {
    position: absolute;
    right: 6px;
    top: 50%;
    transform: translateY(-50%);
    background: none;
    border: none;
    cursor: pointer;
    padding: 6px;
    display: flex;
    align-items: center;
    justify-content: center;
    color: var(--text-secondary);
    border-radius: 6px;
    transition: background 0.15s, color 0.15s;
    line-height: 0;
  }
  
  .pw-toggle:hover {
    background: var(--blue-50);
    color: var(--blue-600);
  }
  
  .btn-loading {
    opacity: 0.8;
    cursor: not-allowed;
    position: relative;
    color: transparent !important;
  }
  
  .btn-loading::after {
    content: "";
    position: absolute;
    left: 50%;
    top: 50%;
    width: 16px;
    height: 16px;
    margin-left: -8px;
    margin-top: -8px;
    border: 2px solid white;
    border-radius: 50%;
    border-top-color: transparent;
    animation: spin 0.8s linear infinite;
  }
  
  @keyframes spin { 100% { transform: rotate(360deg); } }
</style>

<script is:inline>
  function showAlert(message) {
    const el = document.getElementById('auth-alert');
    el.textContent = message;
    el.className = 'auth-alert';
    el.style.display = 'block';
  }
  
  function hideAlert() {
    document.getElementById('auth-alert').style.display = 'none';
  }

  function togglePassword(fieldId) {
    const input = document.getElementById(fieldId);
    const wrapper = input.closest('.password-wrapper');
    const openIcon = wrapper.querySelector('.eye-open');
    const closedIcon = wrapper.querySelector('.eye-closed');

    if (input.type === 'password') {
      input.type = 'text';
      openIcon.style.display = 'none';
      closedIcon.style.display = '';
    } else {
      input.type = 'password';
      openIcon.style.display = '';
      closedIcon.style.display = 'none';
    }
  }

  async function handleLogin(event) {
    event.preventDefault();
    hideAlert();

    const email = document.getElementById('login-email').value.trim();
    const password = document.getElementById('login-password').value;

    if (!email || !password) {
      showAlert('Por favor ingresa tu correo y contraseña.');
      return;
    }

    const btn = document.getElementById('btn-login');
    btn.classList.add('btn-loading');
    btn.disabled = true;

    try {
      const res = await fetch('/api/auth/login', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ email, password }),
      });

      const data = await res.json();

      if (!data.success) {
        showAlert(data.error || 'Error al iniciar sesión.');
        btn.classList.remove('btn-loading');
        btn.disabled = false;
        return;
      }

      window.location.href = '/';
    } catch (err) {
      console.error('Login error:', err);
      showAlert('Error de conexión. Verifica tu conexión e intenta de nuevo.');
      btn.classList.remove('btn-loading');
      btn.disabled = false;
    }
  }
</script>