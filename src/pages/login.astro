---
import BaseLayout from '../layouts/BaseLayout.astro';

// Si ya está autenticado, redirigir al dashboard (SSR check)
const sessionCookie = Astro.cookies.get('appwrite_session');
const userIdCookie = Astro.cookies.get('appwrite_user_id');
const { getCurrentUser } = await import('../lib/auth');
let redirect = false;

if (sessionCookie?.value && userIdCookie?.value) {
  // Decode session secret (it was encoded when set)
  const decodedSecret = decodeURIComponent(sessionCookie.value);
  const user = await getCurrentUser(decodedSecret, userIdCookie.value);
  if (user) redirect = true;
}

if (redirect) {
  return Astro.redirect('/');
}
---

<BaseLayout title="BeneficIA Social — Acceder">
  <div class="auth-container">
    <div class="auth-card">
      
      <div class="auth-header">
        <div class="auth-logo">BeneficIA Social</div>
        <p class="auth-subtitle">Gestiona tus auxilios y beneficios fácil y rápido</p>
      </div>

      <!-- Error / Success Alert -->
      <div id="auth-alert" class="auth-alert" style="display:none;"></div>

      <!-- Tabs de Auth -->
      <div class="s-tabs auth-tabs">
        <div class="s-tab active" id="tab-login" onclick="tabChange('login')">Iniciar sesión</div>
        <div class="s-tab" id="tab-register" onclick="tabChange('register')">Crear cuenta</div>
      </div>

      <!-- Formulario de Login -->
      <form id="form-login" class="auth-form" onsubmit="handleLogin(event)">
        <div class="form-row-1">
          <label class="flabel">Correo electrónico</label>
          <input
            class="finput"
            type="email"
            id="login-email"
            placeholder="ej. maria@ejemplo.com"
            autocomplete="email"
            required
          />
        </div>
        <div class="form-row-1">
          <label class="flabel">Contraseña</label>
          <div class="password-wrapper">
            <input
              class="finput"
              type="password"
              id="login-password"
              placeholder="••••••••"
              autocomplete="current-password"
              required
            />
            <button type="button" class="pw-toggle" onclick="togglePassword('login-password')" aria-label="Mostrar contraseña" tabindex="-1">
              <svg class="eye-open" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"/><circle cx="12" cy="12" r="3"/></svg>
              <svg class="eye-closed" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="display:none;"><path d="M17.94 17.94A10.07 10.07 0 0 1 12 20c-7 0-11-8-11-8a18.45 18.45 0 0 1 5.06-5.94M9.9 4.24A9.12 9.12 0 0 1 12 4c7 0 11 8 11 8a18.5 18.5 0 0 1-2.16 3.19m-6.72-1.07a3 3 0 1 1-4.24-4.24"/><line x1="1" y1="1" x2="23" y2="23"/></svg>
            </button>
          </div>
        </div>

        <button type="submit" class="submit-btn" id="btn-login">
          Ingresar de forma segura →
        </button>
      </form>

      <!-- Formulario de Registro -->
      <form id="form-register" class="auth-form" style="display:none;" onsubmit="handleRegister(event)">
        <div class="form-row-1">
          <label class="flabel">Nombre completo</label>
          <input class="finput" type="text" id="reg-name" placeholder="Ej. María López Herrera" required />
        </div>
        <div class="form-row">
          <div>
            <label class="flabel">Cédula de ciudadanía</label>
            <input class="finput" type="text" id="reg-cedula" placeholder="1052487903" required />
          </div>
          <div>
            <label class="flabel">Correo electrónico</label>
            <input class="finput" type="email" id="reg-email" placeholder="maria@ejemplo.com" autocomplete="email" required />
          </div>
        </div>
        <div class="form-row-1">
          <label class="flabel">Crear contraseña</label>
          <div class="password-wrapper">
            <input
              class="finput"
              type="password"
              id="reg-password"
              placeholder="Mín. 8 caracteres, 1 mayúscula, 1 número"
              minlength="8"
              autocomplete="new-password"
              required
            />
            <button type="button" class="pw-toggle" onclick="togglePassword('reg-password')" aria-label="Mostrar contraseña" tabindex="-1">
              <svg class="eye-open" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"/><circle cx="12" cy="12" r="3"/></svg>
              <svg class="eye-closed" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="display:none;"><path d="M17.94 17.94A10.07 10.07 0 0 1 12 20c-7 0-11-8-11-8a18.45 18.45 0 0 1 5.06-5.94M9.9 4.24A9.12 9.12 0 0 1 12 4c7 0 11 8 11 8a18.5 18.5 0 0 1-2.16 3.19m-6.72-1.07a3 3 0 1 1-4.24-4.24"/><line x1="1" y1="1" x2="23" y2="23"/></svg>
            </button>
          </div>
          <div class="password-hints" id="reg-password-hints">
            <span class="hint" data-check="length">● 8+ caracteres</span>
            <span class="hint" data-check="upper">● 1 mayúscula</span>
            <span class="hint" data-check="lower">● 1 minúscula</span>
            <span class="hint" data-check="number">● 1 número</span>
          </div>
        </div>

        <div class="auth-extras" style="margin-bottom: 1rem;">
          <label class="check-container">
            <input type="checkbox" id="reg-consent" required />
            <span class="checkmark"></span>
            <span class="chk-label">Acepto la política de tratamiento de datos</span>
          </label>
        </div>

        <button type="submit" class="submit-btn" id="btn-register">Registrarme y acceder →</button>
      </form>

    </div>
  </div>
</BaseLayout>

<style>
  .auth-container {
    display: flex;
    align-items: center;
    justify-content: center;
    min-height: 80vh;
  }

  .auth-card {
    background: var(--surface);
    border: 0.5px solid var(--border);
    border-radius: var(--radius-lg);
    padding: 2.5rem 2rem;
    width: 100%;
    max-width: 440px;
    box-shadow: 0 10px 25px rgba(0,0,0,0.05);
  }

  .auth-header {
    text-align: center;
    margin-bottom: 1.5rem;
  }

  .auth-logo {
    font-size: 22px;
    font-weight: 600;
    color: var(--blue-800);
    margin-bottom: 6px;
    letter-spacing: -0.5px;
  }

  .auth-subtitle {
    font-size: 13px;
    color: var(--text-secondary);
  }

  .auth-tabs {
    display: flex;
    margin-bottom: 1.5rem;
    background: var(--gray-bg);
    padding: 4px;
    border-radius: 20px;
  }

  .auth-tabs .s-tab {
    flex: 1;
    text-align: center;
    border: none;
    background: transparent;
  }

  .auth-tabs .s-tab.active {
    background: var(--surface);
    color: var(--blue-800);
    font-weight: 500;
    box-shadow: 0 2px 5px rgba(0,0,0,0.04);
  }

  .auth-extras {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-top: 8px;
    margin-bottom: 1.25rem;
  }

  /* ── Alert ── */
  .auth-alert {
    background: var(--red-50);
    border: 0.5px solid var(--red-400);
    border-radius: var(--radius-md);
    padding: 10px 14px;
    font-size: 13px;
    color: var(--red-800);
    margin-bottom: 1rem;
    line-height: 1.4;
  }
  .auth-alert.success {
    background: var(--green-50);
    border-color: var(--green-400);
    color: var(--green-800);
  }

  /* ── Password wrapper with toggle ── */
  .password-wrapper {
    position: relative;
    display: flex;
    align-items: center;
  }
  .password-wrapper .finput {
    padding-right: 40px;
  }
  .pw-toggle {
    position: absolute;
    right: 6px;
    top: 50%;
    transform: translateY(-50%);
    background: none;
    border: none;
    cursor: pointer;
    padding: 6px;
    display: flex;
    align-items: center;
    justify-content: center;
    color: var(--text-secondary);
    border-radius: 6px;
    transition: background 0.15s, color 0.15s;
    line-height: 0;
  }
  .pw-toggle:hover {
    background: var(--blue-50);
    color: var(--blue-600);
  }
  .pw-toggle:focus-visible {
    outline: 2px solid var(--blue-400);
    outline-offset: 2px;
  }

  /* ── Password hints ── */
  .password-hints {
    display: flex;
    flex-wrap: wrap;
    gap: 4px 12px;
    margin-top: 6px;
  }
  .hint {
    font-size: 11px;
    color: var(--text-secondary);
    transition: color 0.15s;
  }
  .hint.valid {
    color: var(--green-400);
  }
  .hint.invalid {
    color: var(--red-400);
  }

  /* ── Button loading state ── */
  .btn-loading {
    opacity: 0.8;
    cursor: not-allowed;
    position: relative;
    color: transparent !important;
  }
  .btn-loading::after {
    content: "";
    position: absolute;
    left: 50%;
    top: 50%;
    width: 16px;
    height: 16px;
    margin-left: -8px;
    margin-top: -8px;
    border: 2px solid white;
    border-radius: 50%;
    border-top-color: transparent;
    animation: spin 0.8s linear infinite;
  }
  @keyframes spin { 100% { transform: rotate(360deg); } }
</style>

<script is:inline>
  // ── Tab switching ──
  function tabChange(mode) {
    document.getElementById('tab-login').classList.toggle('active', mode === 'login');
    document.getElementById('tab-register').classList.toggle('active', mode === 'register');
    document.getElementById('form-login').style.display = mode === 'login' ? 'block' : 'none';
    document.getElementById('form-register').style.display = mode === 'register' ? 'block' : 'none';
    document.getElementById('auth-alert').style.display = 'none';
  }

  // ── Alert helper ──
  function showAlert(message, type) {
    const el = document.getElementById('auth-alert');
    el.textContent = message;
    el.className = 'auth-alert' + (type === 'success' ? ' success' : '');
    el.style.display = 'block';
  }
  function hideAlert() {
    document.getElementById('auth-alert').style.display = 'none';
  }

  // ── Password validation hints ──
  document.addEventListener('DOMContentLoaded', () => {
    const pwInput = document.getElementById('reg-password');
    if (pwInput) {
      pwInput.addEventListener('input', function () {
        const val = this.value;
        updateHint('length', val.length >= 8);
        updateHint('upper', /[A-Z]/.test(val));
        updateHint('lower', /[a-z]/.test(val));
        updateHint('number', /[0-9]/.test(val));
      });
    }
  });

  // ── Password visibility toggle ──
  function togglePassword(fieldId) {
    const input = document.getElementById(fieldId);
    const wrapper = input.closest('.password-wrapper');
    const openIcon = wrapper.querySelector('.eye-open');
    const closedIcon = wrapper.querySelector('.eye-closed');
    const btn = wrapper.querySelector('.pw-toggle');

    if (!input) return;

    if (input.type === 'password') {
      input.type = 'text';
      openIcon.style.display = 'none';
      closedIcon.style.display = '';
      btn.setAttribute('aria-label', 'Ocultar contraseña');
    } else {
      input.type = 'password';
      openIcon.style.display = '';
      closedIcon.style.display = 'none';
      btn.setAttribute('aria-label', 'Mostrar contraseña');
    }
  }

  function updateHint(check, valid) {
    const el = document.querySelector(`.hint[data-check="${check}"]`);
    if (el) {
      el.classList.toggle('valid', valid);
      el.classList.toggle('invalid', !valid);
    }
  }

  // ── Login ──
  async function handleLogin(event) {
    event.preventDefault();
    hideAlert();

    const email = document.getElementById('login-email').value.trim();
    const password = document.getElementById('login-password').value;

    if (!email || !password) {
      showAlert('Por favor ingresa tu correo y contraseña.');
      return;
    }

    const btn = document.getElementById('btn-login');
    setLoading(btn, true);

    try {
      const res = await fetch('/api/auth/login', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ email, password }),
      });

      const data = await res.json();

      if (!data.success) {
        showAlert(data.error || 'Error al iniciar sesión.');
        setLoading(btn, false);
        return;
      }

      // Redirect to dashboard
      window.location.href = '/';
    } catch (err) {
      console.error('Login error:', err);
      showAlert('Error de conexión. Verifica tu conexión e intenta de nuevo.');
      setLoading(btn, false);
    }
  }

  // ── Register ──
  async function handleRegister(event) {
    event.preventDefault();
    hideAlert();

    const name = document.getElementById('reg-name').value.trim();
    const cedula = document.getElementById('reg-cedula').value.trim();
    const email = document.getElementById('reg-email').value.trim();
    const password = document.getElementById('reg-password').value;
    const consent = document.getElementById('reg-consent').checked;

    // ── Client-side validation ──
    if (!name || !cedula || !email || !password) {
      showAlert('Todos los campos son obligatorios.');
      return;
    }

    if (!consent) {
      showAlert('Debes aceptar la política de tratamiento de datos.');
      return;
    }

    if (password.length < 8) {
      showAlert('La contraseña debe tener al menos 8 caracteres.');
      return;
    }

    if (!/^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(email)) {
      showAlert('El correo electrónico no es válido.');
      return;
    }

    if (!/^\d{5,15}$/.test(cedula)) {
      showAlert('La cédula debe contener solo números (5-15 dígitos).');
      return;
    }

    const btn = document.getElementById('btn-register');
    setLoading(btn, true);

    try {
      const res = await fetch('/api/auth/register', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ name, cedula, email, password }),
      });

      const data = await res.json();

      if (!data.success) {
        showAlert(data.error || 'Error al registrar.');
        setLoading(btn, false);
        return;
      }

      // Redirect to dashboard (auto-logged in via cookie)
      window.location.href = '/';
    } catch (err) {
      console.error('Register error:', err);
      showAlert('Error de conexión. Verifica tu conexión e intenta de nuevo.');
      setLoading(btn, false);
    }
  }

  // ── Utilities ──
  function setLoading(btn, loading) {
    btn.classList.toggle('btn-loading', loading);
    btn.disabled = loading;
  }
</script>
