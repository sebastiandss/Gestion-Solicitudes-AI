---
// MisTramites.astro
---

<div id="view-tramites">
  <div class="summary-grid">
    <div class="sum-card">
      <div class="sum-label">Trámites totales</div>
      <div class="sum-val" id="stat-totales">0</div>
      <div class="sum-sub" id="stat-totales-sub">Sin trámites actuales</div>
    </div>
    <div class="sum-card">
      <div class="sum-label">Último estado</div>
      <div class="sum-val" id="stat-estado" style="color:var(--text-secondary);">Ninguno</div>
      <div class="sum-sub" id="stat-estado-sub">-</div>
    </div>
    <div class="sum-card">
      <div class="sum-label">Beneficio recibido</div>
      <div class="sum-val">$0</div>
      <div class="sum-sub">Acumulado 2026</div>
    </div>
  </div>

  <div class="card">
    <div class="sec-title">
      <span class="sec-title-dot"></span> Mis solicitudes
    </div>

    <!-- Contenedor inyectado dinamicamente -->
    <div id="tramites-container">
      <div style="text-align: center; padding: 2rem 1rem; color: var(--text-secondary); font-size: 13px;">
        Cargando trámites...
      </div>
    </div>
  </div>

  <!-- Panel IA -->
  <div class="ia-panel">
    <div class="ia-head" id="ia-head">
      <span class="ia-title">Análisis IA</span>
    </div>
    <div id="ia-content">
      <div class="ia-item" style="color:var(--text-secondary);">
        No hay análisis de IA activos en este momento.
      </div>
    </div>
  </div>

  <!-- Modal Detalle -->
  <div class="modal-overlay" id="tramite-modal">
    <div class="modal-content">
      <div class="tr-top" style="margin-bottom: 12px;">
        <span class="tr-name" id="modal-title" style="font-size: 16px;">Detalle</span>
        <span class="modal-close" onclick="closeDetalleModal()">✕</span>
      </div>
      
      <div style="font-size: 13px; color: var(--text-secondary); margin-bottom: 8px;">
        <strong>ID de Radicado:</strong> <span id="modal-id">...</span>
      </div>
      <div style="font-size: 13px; color: var(--text-secondary); margin-bottom: 8px;">
        <strong>Fecha:</strong> <span id="modal-fecha">...</span>
      </div>
      <div style="font-size: 13px; color: var(--text-secondary); margin-bottom: 16px;">
        <strong>Estado actual:</strong> <span id="modal-estado">...</span>
      </div>

      <div class="progress-track" style="margin-bottom: 8px;">
        <div class="progress-bar" id="modal-progress" style="width:0%;"></div>
      </div>
      <div style="font-size: 12px; color: var(--text-primary); text-align: center; margin-bottom: 1rem;">
        Paso actual: <strong id="modal-step">...</strong>
      </div>

      <!-- Área de IA en modal -->
      <div id="modal-ia-box" style="display:none; margin-bottom: 1rem; padding: 10px; background: var(--red-50); border: 0.5px solid var(--red-400); border-radius: var(--radius-md);">
        <div style="font-size: 12px; font-weight: 500; color: var(--red-800); margin-bottom: 4px;">Análisis de Riesgo de Rechazo (IA)</div>
        <div id="modal-ia-rejection-content" style="font-size: 12px; color: var(--text-primary);"></div>
      </div>

      <button type="button" class="cancel-btn" id="btn-ia-reject" style="width: 100%; border-color: var(--teal-400); color: var(--teal-400); margin-bottom: 8px; font-weight: 500;">
        ✨ Analizar riesgo de rechazo (IA)
      </button>

      <div style="display: flex; gap: 8px;">
        <button class="submit-btn" style="flex: 1; padding: 8px; font-size: 13px;" onclick="closeDetalleModal()">Cerrar panel</button>
        <button class="cancel-btn" id="btn-delete-tramite" style="flex: 1; margin-top: 0; padding: 8px; font-size: 13px; border-color: var(--red-400); color: var(--red-400);">Eliminar</button>
      </div>
    </div>
  </div>
</div>

<style is:global>
  /* Modal Styles */
  .modal-overlay {
    position: fixed; top: 0; left: 0; right: 0; bottom: 0;
    background: rgba(0,0,0,0.5);
    display: flex; align-items: center; justify-content: center;
    z-index: 1000;
    opacity: 0; pointer-events: none; transition: opacity 0.2s;
  }
  .modal-overlay.active { opacity: 1; pointer-events: all; }
  .modal-content {
    background: var(--surface); padding: 1.5rem; border-radius: var(--radius-lg);
    width: 90%; max-width: 400px;
    transform: translateY(20px); transition: transform 0.2s;
    box-shadow: 0 10px 25px rgba(0,0,0,0.1);
  }
  .modal-overlay.active .modal-content { transform: translateY(0); }
  .modal-close { 
    cursor: pointer; color: var(--text-secondary);
    font-size: 18px; line-height: 1;
  }
  .modal-close:hover { color: var(--text-primary); }
</style>

<script is:inline>
  // ── State mapping helpers ─────────────────────────────────
  const ESTADO_LABELS = {
    radicada: 'Radicada',
    en_estudio: 'En estudio',
    en_aprobacion: 'En aprobación',
    aprobada: 'Aprobada',
    en_pago: 'En pago',
    pagada: 'Pagada',
    negada: 'Negada',
    en_cola_por_fondos: 'En espera por fondos',
  };

  const ESTADO_CLASSES = {
    radicada: 'b-blue',
    en_estudio: 'b-amber',
    en_aprobacion: 'b-amber',
    aprobada: 'b-green',
    en_pago: 'b-green',
    pagada: 'b-green',
    negada: 'b-red',
    en_cola_por_fondos: 'b-amber',
  };

  const ESTADO_PROGRESS = {
    radicada: 10,
    en_estudio: 30,
    en_aprobacion: 50,
    aprobada: 70,
    en_pago: 85,
    pagada: 100,
    negada: 100,
    en_cola_por_fondos: 60,
  };

  const ESTADO_STEPS = {
    radicada: 'Validación inicial · Pendiente de revisión',
    en_estudio: 'En estudio por el comité evaluador',
    en_aprobacion: 'En proceso de aprobación',
    aprobada: 'Aprobada · En proceso de desembolso',
    en_pago: 'En proceso de pago',
    pagada: 'Pago realizado exitosamente',
    negada: 'Solicitud negada',
    en_cola_por_fondos: 'Aprobada · En espera de disponibilidad de fondos',
  };

  // ── Cache ────────────────────────────────────────────────
  let cachedAuxilios = null;
  let cachedSolicitudes = null;

  async function fetchAuxilios() {
    if (cachedAuxilios) return cachedAuxilios;
    try {
      const res = await fetch('/api/auxilios', { credentials: 'include' });
      const json = await res.json();
      if (json.success && json.data) {
        cachedAuxilios = json.data;
        return cachedAuxilios;
      }
    } catch (e) {
      console.error('Error fetching auxilios:', e);
    }
    return [];
  }

  function getAuxilioName(auxilioId, auxilios) {
    const aux = auxilios.find(a => a.$id === auxilioId);
    return aux ? aux.nombre : 'Auxilio';
  }

  function getAuxilioTipo(auxilioId, auxilios) {
    const aux = auxilios.find(a => a.$id === auxilioId);
    return aux ? aux.tipoPrincipal : 'General';
  }

  function formatDate(isoStr) {
    if (!isoStr) return 'Fecha no disponible';
    const d = new Date(isoStr);
    return 'Radicado ' + d.toLocaleDateString('es-CO', { day: '2-digit', month: 'short', year: 'numeric' });
  }

  async function renderTramites() {
    const container = document.getElementById('tramites-container');
    container.innerHTML = '<div style="text-align: center; padding: 2rem 1rem; color: var(--text-secondary); font-size: 13px;">Cargando trámites...</div>';

    try {
      const response = await fetch('/api/solicitudes', { credentials: 'include' });
      const json = await response.json();

      if (!json.success || !json.data) {
        container.innerHTML = '<div style="text-align: center; padding: 2rem 1rem; color: var(--text-secondary); font-size: 13px;">No se pudieron cargar los trámites.</div>';
        return;
      }

      const solicitudes = json.data;
      cachedSolicitudes = solicitudes;

      if (response.status === 404) {
        container.innerHTML = '<div style="text-align: center; padding: 2rem 1rem; color: var(--text-secondary); font-size: 13px;">Perfil de asociado no encontrado.</div>';
        return;
      }

      const auxilios = await fetchAuxilios();

      // Update stats
      document.getElementById('stat-totales').textContent = solicitudes.length;
      document.getElementById('stat-totales-sub').textContent =
        solicitudes.length === 0 ? 'Sin trámites actuales' : solicitudes.length + ' trámite(s)';

      if (solicitudes.length > 0) {
        const ultimo = solicitudes[0];
        const estadoLabel = ESTADO_LABELS[ultimo.estado] || ultimo.estado;
        const estadoEl = document.getElementById('stat-estado');
        estadoEl.textContent = estadoLabel;

        if (ultimo.estado === 'aprobada' || ultimo.estado === 'en_pago' || ultimo.estado === 'pagada')
          estadoEl.style.color = 'var(--green-400)';
        else if (ultimo.estado === 'en_estudio' || ultimo.estado === 'en_aprobacion' || ultimo.estado === 'en_cola_por_fondos')
          estadoEl.style.color = 'var(--amber-400)';
        else if (ultimo.estado === 'negada')
          estadoEl.style.color = 'var(--red-400)';
        else
          estadoEl.style.color = 'var(--blue-600)';

        document.getElementById('stat-estado-sub').textContent = getAuxilioName(ultimo.auxilioId, auxilios);
      } else {
        document.getElementById('stat-estado').textContent = 'Ninguno';
        document.getElementById('stat-estado').style.color = 'var(--text-secondary)';
        document.getElementById('stat-estado-sub').textContent = '-';
      }

      // Render list
      if (solicitudes.length === 0) {
        container.innerHTML = '<div style="text-align: center; padding: 2rem 1rem; color: var(--text-secondary); font-size: 13px;">No tienes solicitudes de trámites actualmente.</div>';
      } else {
        container.innerHTML = solicitudes.map(s => {
          const estadoLabel = ESTADO_LABELS[s.estado] || s.estado;
          const estadoClass = ESTADO_CLASSES[s.estado] || 'b-gray';
          const progWidth = ESTADO_PROGRESS[s.estado] || 0;
          const progClass = estadoClass.replace('b-', 'pb-');
          const auxName = getAuxilioName(s.auxilioId, auxilios);
          const tipoBadge = getAuxilioTipo(s.auxilioId, auxilios);
          const fechaText = formatDate(s.fechaRadicacion);
          const stepText = ESTADO_STEPS[s.estado] || 'En proceso';

          return `<div class="tramite-row">
            <div class="tr-top">
              <span class="tr-name">${auxName}</span>
              <div style="display: flex; gap: 6px; align-items: center;">
                <span class="badge" style="background:var(--gray-bg); color:var(--text-secondary); border:none;">${tipoBadge}</span>
                <span class="badge ${estadoClass}">${estadoLabel}</span>
              </div>
            </div>
            <div class="tr-mid">
              <span class="tr-tipo">${tipoBadge}</span>
              <span class="tr-date">${fechaText}</span>
            </div>
            <div class="progress-track">
              <div class="progress-bar ${progClass}" style="width:${progWidth}%;"></div>
            </div>
            <div class="tr-foot">
              <span class="tr-step">${stepText}</span>
              <span class="${s.estado === 'negada' ? 'tr-link-red' : 'tr-link'}" onclick="openDetalleModal('${s.$id}')">Ver detalle</span>
            </div>
          </div>`;
        }).join('');
      }

      // Update IA Panel
      updateIAPanel(solicitudes);

    } catch (err) {
      console.error('Error loading tramites:', err);
      container.innerHTML = '<div style="text-align: center; padding: 2rem 1rem; color: var(--red-400); font-size: 13px;">Error al cargar trámites. Verifique su conexión.</div>';
    }
  }

  function updateIAPanel(solicitudes) {
    const iaContainer = document.getElementById('ia-content');
    const iaHead = document.getElementById('ia-head');
    const enEstudio = solicitudes.filter(s =>
      s.estado === 'en_estudio' || s.estado === 'radicada' || s.estado === 'en_aprobacion'
    );

    if (enEstudio.length > 0) {
      if (!document.getElementById('ia-pulse-loader')) {
        iaHead.insertAdjacentHTML('afterbegin', '<div class="ia-pulse" id="ia-pulse-loader"></div>');
      }
      iaContainer.innerHTML = `
        <div class="ia-item"><span class="ia-ic" style="color:var(--green-400);">✓</span> Identidad verificada — Asociado activo</div>
        <div class="ia-item"><span class="ia-ic" style="color:var(--amber-600);">⏳</span> ${enEstudio.length} solicitud(es) en proceso de evaluación</div>
        <div class="ia-item" style="color:var(--text-secondary);"><span class="ia-ic">◯</span> Próxima revisión de comité pendiente</div>
      `;
    } else {
      const pulse = document.getElementById('ia-pulse-loader');
      if (pulse) pulse.remove();
      iaContainer.innerHTML = `
        <div class="ia-item" style="color:var(--text-secondary);">
          No hay análisis de IA activos en este momento.
        </div>
      `;
    }
  }

  // ── Modal Logic ─────────────────────────────────────────

  async function openDetalleModal(id) {
    if (!cachedSolicitudes) {
      try {
        const res = await fetch('/api/solicitudes', { credentials: 'include' });
        const json = await res.json();
        if (json.success) cachedSolicitudes = json.data;
      } catch (e) {
        console.error(e);
        return;
      }
    }

    const solicitud = cachedSolicitudes.find(s => s.$id === id);
    if (!solicitud) return;

    const auxilios = await fetchAuxilios();
    const auxName = getAuxilioName(solicitud.auxilioId, auxilios);
    const estadoLabel = ESTADO_LABELS[solicitud.estado] || solicitud.estado;
    const estadoClass = ESTADO_CLASSES[solicitud.estado] || 'b-gray';
    const progWidth = ESTADO_PROGRESS[solicitud.estado] || 0;
    const progClass = estadoClass.replace('b-', 'pb-');
    const stepText = ESTADO_STEPS[solicitud.estado] || 'En proceso';

    document.getElementById('modal-title').textContent = auxName;
    document.getElementById('modal-id').textContent = id;
    document.getElementById('modal-fecha').textContent = formatDate(solicitud.fechaRadicacion);

    const est = document.getElementById('modal-estado');
    est.textContent = estadoLabel;
    est.className = 'badge ' + estadoClass;

    const prog = document.getElementById('modal-progress');
    prog.style.width = progWidth + '%';
    prog.className = 'progress-bar ' + progClass;

    document.getElementById('modal-step').textContent = stepText;

    // Delete button — only show for radicada
    const btnDelete = document.getElementById('btn-delete-tramite');
    if (solicitud.estado === 'radicada') {
      btnDelete.style.display = 'block';
      btnDelete.onclick = () => deleteTramite(id);
    } else {
      btnDelete.style.display = 'none';
    }

    // Reset AI box
    document.getElementById('modal-ia-box').style.display = 'none';
    const btnIa = document.getElementById('btn-ia-reject');
    btnIa.style.display = solicitud.descripcion ? 'block' : 'none';
    btnIa.innerHTML = '✨ Analizar riesgo de rechazo (IA)';
    btnIa.disabled = false;
    btnIa.onclick = () => analizarRechazoIA(id);

    document.getElementById('tramite-modal').classList.add('active');
  }

  async function deleteTramite(id) {
    if (!confirm("¿Estás seguro de que deseas eliminar esta solicitud permanentemente?")) return;

    try {
      const response = await fetch('/api/solicitudes/' + id, { method: 'DELETE', credentials: 'include' });
      const json = await response.json();

      if (!response.ok) {
        alert(json.error || 'No se pudo eliminar la solicitud.');
        return;
      }

      closeDetalleModal();
      // Invalidate cache and reload
      cachedSolicitudes = null;
      renderTramites();
    } catch (err) {
      console.error('Error deleting tramite:', err);
      alert('Error de conexión al eliminar la solicitud.');
    }
  }

  async function analizarRechazoIA(id) {
    if (!cachedSolicitudes) {
      try {
        const res = await fetch('/api/solicitudes', { credentials: 'include' });
        const json = await res.json();
        if (json.success) cachedSolicitudes = json.data;
      } catch (e) { return; }
    }

    const solicitud = cachedSolicitudes.find(s => s.$id === id);
    if (!solicitud || !solicitud.descripcion) return;

    const auxilios = await fetchAuxilios();
    const auxName = getAuxilioName(solicitud.auxilioId, auxilios);

    const btn = document.getElementById('btn-ia-reject');
    const box = document.getElementById('modal-ia-box');
    const content = document.getElementById('modal-ia-rejection-content');

    btn.innerHTML = '✨ Analizando...';
    btn.disabled = true;
    box.style.display = 'block';
    content.innerHTML = '<span style="color:var(--text-secondary);">Generando análisis de riesgo...</span>';

    try {
      const response = await fetch('/api/solicitudes/' + id + '/analizar', {
        method: 'POST',
        credentials: 'include',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({
          name: auxName,
          descripcion: solicitud.descripcion,
        }),
      });

      const data = await response.json();
      if (data.error) throw new Error(data.error);
      content.innerHTML = data.analysis;
    } catch (err) {
      console.error(err);
      content.innerHTML = '<span style="color: var(--red-400);">Hubo un error contactando a la IA. Revisa la consola.</span>';
    } finally {
      btn.innerHTML = '✨ Analizar riesgo de rechazo (IA)';
      btn.disabled = false;
    }
  }

  function closeDetalleModal() {
    document.getElementById('tramite-modal').classList.remove('active');
  }

  // ── Initialization ──────────────────────────────────────
  document.addEventListener('DOMContentLoaded', () => {
    setTimeout(renderTramites, 50);
  });

  window.addEventListener('tramitesUpdated', () => {
    cachedSolicitudes = null;
    renderTramites();
  });
</script>
