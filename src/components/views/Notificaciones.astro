<div id="view-notificaciones" style="display:none;">
  <div class="card">
    <div class="sec-title" style="display: flex; justify-content: space-between; align-items: center;">
      <div><span class="sec-title-dot"></span> Mis notificaciones</div>
    </div>

    <div id="notif-container">
      <div style="text-align: center; padding: 2rem 1rem; color: var(--text-secondary); font-size: 13px;">
        Cargando notificaciones...
      </div>
    </div>
  </div>
</div>

<script is:inline>
  // ── Icon mapping by notification type ──
  var NOTIF_ICONS = {
    solicitud_creada:  { class: 'ni-blue',   text: 'S' },
    nueva_solicitud:   { class: 'ni-blue',   text: 'S' },
    estado_cambio:     { class: 'ni-blue',   text: '\u21BB' },
    documento_faltante:{ class: 'ni-amber',  text: '!' },
    aprobacion:        { class: 'ni-green',  text: '\u2713' },
    rechazo:           { class: 'ni-red',    text: '\u2717' },
    recordatorio:      { class: 'ni-blue',   text: '\u23F0' },
  };

  /** Format an ISO date string to a relative time label (Spanish). */
  function timeAgo(isoDate) {
    var diff = Date.now() - new Date(isoDate).getTime();
    var mins = Math.floor(diff / 60000);
    if (mins < 1) return 'Ahora';
    if (mins < 60) return 'Hace ' + mins + ' min';
    var hours = Math.floor(mins / 60);
    if (hours < 24) return 'Hace ' + hours + (hours === 1 ? ' hora' : ' horas');
    var days = Math.floor(hours / 24);
    if (days === 1) return 'Ayer';
    if (days < 7) return 'Hace ' + days + ' d\u00EDas';
    return new Date(isoDate).toLocaleDateString('es-CO');
  }

  /** Fetch notifications from the API and render them. */
  async function renderNotificaciones() {
    var container = document.getElementById('notif-container');
    if (!container) return;

    try {
      var res = await fetch('/api/notificaciones', { credentials: 'include' });
      if (!res.ok) {
        container.innerHTML = '<div style="text-align:center;padding:2rem 1rem;color:var(--red-400);font-size:13px;">Error al cargar notificaciones.</div>';
        return;
      }
      var json = await res.json();
      var notifs = json.data || [];

      if (notifs.length === 0) {
        container.innerHTML = '<div style="text-align:center;padding:2rem 1rem;color:var(--text-secondary);font-size:13px;">No tienes notificaciones recientes.</div>';
        return;
      }

      container.innerHTML = notifs.map(function (n) {
        var icon = NOTIF_ICONS[n.tipo] || { class: 'ni-blue', text: 'i' };
        var unreadClass = n.leida ? '' : ' style="border-left: 2px solid var(--blue-400); padding-left: 8px; font-weight: 500;"';
        return '<div class="notif-item"' + unreadClass + ' data-id="' + n.$id + '" onclick="markAsRead(this, \'' + n.$id + '\')" style="cursor:pointer;">' +
          '<div class="notif-icon ' + icon.class + '">' + icon.text + '</div>' +
          '<div>' +
            '<div class="notif-msg">' + escapeHtml(n.mensaje) + '</div>' +
            '<div class="notif-time">' + timeAgo(n.fecha) + '</div>' +
          '</div>' +
        '</div>';
      }).join('');
    } catch (e) {
      container.innerHTML = '<div style="text-align:center;padding:2rem 1rem;color:var(--red-400);font-size:13px;">Error de conexi\u00F3n al cargar notificaciones.</div>';
    }
  }

  /** Escape HTML entities to prevent XSS. */
  function escapeHtml(str) {
    return String(str)
      .replace(/&/g, '&amp;')
      .replace(/</g, '&lt;')
      .replace(/>/g, '&gt;')
      .replace(/"/g, '&quot;')
      .replace(/'/g, '&#039;');
  }

  /** Mark a notification as read via the API. */
  async function markAsRead(el, id) {
    if (el.dataset.reading === 'true') return; // debounce
    el.dataset.reading = 'true';

    try {
      var res = await fetch('/api/notificaciones/' + id + '/read', { method: 'PUT', credentials: 'include' });
      if (res.ok) {
        // Remove the unread visual indicator
        el.style.borderLeft = '';
        el.style.paddingLeft = '';
        el.style.fontWeight = '';
      }
    } catch (e) {
      // Silently ignore — retry on next render
    } finally {
      el.dataset.reading = 'false';
    }
  }

  // ── Bootstrap ──
  document.addEventListener('DOMContentLoaded', function () {
    setTimeout(renderNotificaciones, 50);
  });

  window.addEventListener('notifsUpdated', renderNotificaciones);
</script>
