<div id="view-programas" style="display:none;">
  <div class="card">
    <div class="sec-title">
      <span class="sec-title-dot"></span> Programas disponibles para ti
    </div>

    <div id="prog-container">
      <!-- injected via JS -->
    </div>
  </div>
</div>

<script is:inline>
  let programasRendered = false;

  async function renderProgramas() {
    if (programasRendered) return;
    
    const container = document.getElementById('prog-container');
    if (!container) return;

    container.innerHTML = '<div style="text-align:center; padding:20px; color:var(--text-secondary);">Cargando programas...</div>';

    try {
      const res = await fetch('/api/programas', { credentials: 'include' });
      if (!res.ok) throw new Error('Error al cargar programas');

      const json = await res.json();
      const programas = json.success ? json.data : [];

      if (!programas || programas.length === 0) {
        container.innerHTML = '<div style="text-align:center; padding:20px; color:var(--text-secondary);">No hay programas disponibles en este momento.</div>';
        return;
      }

      const html = programas.map(function(prog) {
        return '<div class="prog-item">' +
          '<div class="prog-head">' +
            '<div class="prog-name">' + prog.nombre + '</div>' +
            '<span class="badge ' + prog.badgeClass + '">' + prog.badgeText + '</span>' +
          '</div>' +
          '<div class="prog-desc" style="color:var(--text-secondary); font-size:13px; line-height:1.5; margin-bottom:12px;">' + prog.descripcion + '</div>' +
          '<div class="prog-track">' +
            '<div class="prog-fill" style="width:' + prog.progress + '%; background:' + prog.progressColor + ';"></div>' +
          '</div>' +
          '<div class="prog-foot">' +
            '<span>' + prog.progressText + '</span>' +
            '<span class="prog-apply" style="cursor:pointer; color:var(--teal-600); font-weight:500;" onclick="aplicarPrograma(\'' + prog.tipoPrincipal + '\', \'' + prog.subTipo + '\')">Aplicar ahora →</span>' +
          '</div>' +
        '</div>';
      }).join('');
      
      container.innerHTML = html;
      programasRendered = true;
    } catch (err) {
      console.error('Error cargando programas:', err);
      container.innerHTML = '<div style="text-align:center; padding:20px; color:var(--text-secondary);">No se pudieron cargar los programas.</div>';
    }
  }

  function aplicarPrograma(tipoPrincipal, subTipo) {
    switchTab('nueva');
    setTimeout(function() {
      const tabEl = document.querySelector('.s-tab[data-tipo="' + tipoPrincipal + '"]');
      if(tabEl) {
         selTipo(tabEl, tipoPrincipal);
         setTimeout(function() {
           const subSelect = document.getElementById('tipoEvento');
           if (subSelect && subTipo) subSelect.value = subTipo;
         }, 50);
      }
    }, 50);
  }

  renderProgramas();
</script>
