---
// NavigationTabs.astro
export interface Props {
  esAdmin?: boolean;
}

const { esAdmin = false } = Astro.props;
---

<div class="tabs" id="mainTabs">
  <div class="tab active" onclick="switchTab('tramites')">Mis trámites</div>
  <div class="tab" onclick="switchTab('nueva')">Nueva solicitud</div>
  <div class="tab" onclick="switchTab('programas')">Programas disponibles</div>
  <div class="tab" onclick="switchTab('beneficiarios')">Beneficiarios</div>
  <div class="tab" onclick="switchTab('notificaciones')">Notificaciones</div>
  {esAdmin && <div class="tab" onclick="switchTab('admin')">Panel admin</div>}
</div>
